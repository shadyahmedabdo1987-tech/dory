# Firebase web-app config (Firebase console → Project settings → Your apps → Web app).
# These values are public identifiers, not secrets: access is enforced by firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: point the app at the local emulators (your computer's LAN IP).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10

# App Check: on by default in native builds. Set to "off" while testing in Expo Go.
EXPO_PUBLIC_APP_CHECK=off
# Debug token registered in Firebase console (App Check → Manage debug tokens) for dev builds.
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# EAS project id (from `eas init`) — needed for push notifications.
# EAS_PROJECT_ID=
