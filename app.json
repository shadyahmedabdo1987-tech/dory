{
  "expo": {
    "name": "دوري",
    "slug": "dory",
    "scheme": "dory",
    "version": "2.27.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#0F5C4D",
    "backgroundColor": "#F6F3EC",
    "ios": {
      "bundleIdentifier": "com.alabdo.dory",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.alabdo.dory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0F5C4D"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F5C4D"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#0F5C4D",
          "defaultChannel": "reminders",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "دوري محتاج يوصل لصورك علشان ترفق صورة تحويل القسط.",
          "cameraPermission": "دوري محتاج الكاميرا علشان تصوّر إيصال تحويل القسط.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "icon": "./assets/icon.png",
    "owner": "shady87"
  }
}
